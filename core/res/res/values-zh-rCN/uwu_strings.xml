<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_jump_prompt_title">允许打开其他应用吗？</string>
    <string name="app_jump_prompt_message">这将允许“<xliff:g id="source_app" example="浏览器">%1$s</xliff:g>”打开“<xliff:g id="target_app" example="地图">%2$s</xliff:g>”。</string>
    <string name="app_jump_allow">允许</string>
    <string name="app_jump_deny">不允许</string>
