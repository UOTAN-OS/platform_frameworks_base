<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_jump_prompt_title">Allow opening other apps?</string>
    <string name="app_jump_prompt_message">
        This will let <xliff:g id="source_app" example="Browser">%1$s</xliff:g> open
        <xliff:g id="target_app" example="Maps">%2$s</xliff:g>.
    </string>
    <string name="app_jump_allow">Allow</string>
    <string name="app_jump_deny">Don’t allow</string>
    <string name="app_jump_allow_once">Allow once</string>
    <string name="app_jump_remember_choice">Remember my choice</string>
    <string name="app_jump_footer_message">You can change app jump permissions any time in Settings.</string>
    <string name="app_jump_blocked_title">Opening other apps is blocked</string>
    <string name="app_jump_blocked_message">
        <xliff:g id="source_app" example="Browser">%1$s</xliff:g> is blocked from opening
        <xliff:g id="target_app" example="Maps">%2$s</xliff:g>. You can still allow this once.
    </string>
</resources>
